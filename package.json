{
  "name": "playforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PLAYFORGE - Real-Time Multiplayer Gaming Platform",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../frontend && npm install",
    "dev:server": "cd server && node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k -n \"SERVER,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "start": "cd server && node server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
